---
.title = "Any model, any hardware",
.description = "Detailed instructions for LLMD installation and launch for all supported model and hardware.",
.date = .date("2026-11-25T00:00:00"),
.layout = "content.shtml",
.custom = .{
    .doc_section = "Tutorials",
    .outline_complete = true,
    .recipe_outline = [
        .{ .id = "choose-platform", .label = "Choose your platform" },
        .{ .id = "before-you-start", .label = "Before you run" },
        .{ .id = "install-llmd", .label = "Install LLMD" },
        .{ .id = "choose-model", .label = "Choose a model" },
        .{ .id = "choose-drafter", .label = "Choose a drafter" },
        .{ .id = "loading-methods", .label = "Choose a weight source" },
        .{ .id = "start-the-server", .label = "Start LLMD" },
        .{ .id = "check-the-loaded-model", .label = "List models" },
        .{ .id = "first-request", .label = "Send a request" },
    ],
},
---
```=html
<div class="llmd-launch" data-llmd-launch>
  <div id="lfm3-fp8-metal"></div>
  <div id="lfm3-fp8-cuda"></div>
  <div id="lfm3-fp8-rocm"></div>
  <div id="lfm3-bf16-metal"></div>
  <div id="lfm3-bf16-cuda"></div>
  <div id="lfm3-bf16-rocm"></div>
  <div id="lfm3-oneapi"></div>
  <div id="lfm3-tpu"></div>
  <div id="lfm3-furiosa"></div>
  <div id="qwen3-8-27b-fp8-metal"></div>
  <div id="qwen3-8-27b-cuda"></div>
  <div id="qwen3-8-27b-rocm"></div>
  <div id="qwen3-8-27b-cuda-dspine"></div>
  <div id="qwen3-8-27b-rocm-dspine"></div>
  <div id="qwen3-8-27b-oneapi"></div>
  <div id="qwen3-8-27b-tpu"></div>
  <div id="qwen3-8-27b-nvfp4-metal"></div>
  <div id="qwen3-8-flash-next-cuda"></div>
  <div id="qwen3-8-flash-next-rocm"></div>
  <div id="deepseek-v4-1-flash-cuda"></div>
  <div id="deepseek-v4-1-flash-rocm"></div>
  <div id="mistral-large-4-cuda"></div>
  <div id="gemma-4-31b-it-cuda"></div>
  <a id="llmd-benchmark" data-moved-topic data-pagefind-ignore href="../../howto/monitoring-and-troubleshooting/#scrape-service-metrics">Scrape service metrics</a>
  <a id="decoding-mode" data-moved-topic data-pagefind-ignore href="../../reference/sampling-and-decoding/#choose-a-decoding-mode">Compare decoding modes</a>
  <a id="gated-checkpoints" data-moved-topic data-pagefind-ignore href="../../reference/environment-variables/#gated-model-access">Gated model access</a>
  <a id="cloud-checkpoints" data-moved-topic data-pagefind-ignore href="../../reference/model-and-listener-flags/#cloud-model-uris">S3 and Google Cloud Storage</a>
  <a id="troubleshooting" data-moved-topic data-pagefind-ignore href="../../howto/monitoring-and-troubleshooting/#diagnose-common-failures">Troubleshoot startup</a>
  <noscript><p>This quickstart shows the Apple Silicon example. Enable JavaScript to choose other platforms and models.</p></noscript>
  <form id="llmd-launch-form" aria-label="LLMD quickstart">
    <section aria-labelledby="choose-platform" data-launch-control data-pagefind-ignore hidden>
      <h2 id="choose-platform">Choose your platform</h2>
      <div class="llmd-launch-field">
        <select id="llmd-launch-backend" name="backend" aria-labelledby="choose-platform">
          <option value="metal">Metal · Apple Silicon</option>
          <option value="cuda">CUDA · NVIDIA GPU</option>
          <option value="rocm">ROCm · AMD GPU</option>
          <option value="oneapi">oneAPI · Intel GPU</option>
          <option value="tpu">Google TPU</option>
          <option value="furiosa">Furiosa RNGD</option>
        </select>
      </div>
    </section>

    <section class="llmd-launch-requirements" aria-labelledby="before-you-start">
      <h2 id="before-you-start">Before you run</h2>
      <p data-requirements>Use an Apple Silicon Mac with macOS Tahoe or later and Homebrew. On M1 and M2, use LLMD 20261112.0 or later.</p>
      <p data-tpu-requirements hidden>The <a href="https://docs.cloud.google.com/tpu/docs/run-in-container">TPU container</a> uses privileged mode and shares the VM's network. Run the requests below from the TPU VM.</p>
      <details data-furiosa-requirements hidden>
        <summary>Set up Furiosa device access</summary>
        <p>Use Docker Engine 25 or later. The Container Device Interface (CDI) tools require Linux kernel 6.3 or later and administrator access. Add Furiosa's package repository and install the RNGD driver first. See the <a href="https://developer.furiosa.ai/latest/en/get_started/prerequisites.html">Furiosa host prerequisites</a>.</p>
        <pre><code class="sh">sudo apt update
sudo apt install furiosa-cdi
sudo furiosa-cdi generate
furiosa-cdi list</code></pre>
        <p>Docker Engine 28.3.0 and later enable CDI by default. On older versions, <a href="https://docs.docker.com/reference/cli/dockerd/#configure-cdi-devices">enable CDI in Docker</a>. Check that <code>furiosa-cdi list</code> includes <code>furiosa.ai/npu=npu0</code>. The <a href="../../reference/docker-options/#accelerators-and-shared-memory">Docker options reference</a> explains the container's device access and security settings.</p>
      </details>
    </section>

    <section aria-labelledby="install-llmd">
      <h2 id="install-llmd" data-setup-title>Install LLMD</h2>
      <div class="command-shell">
        <span class="command-language icon-code">Host shell</span>
        <pre><code class="sh" data-command="setup" data-copy-label="Copy LLMD setup command">brew install zml/zml/llmd</code></pre>
      </div>
    </section>

    <section aria-labelledby="choose-model" data-launch-control data-pagefind-ignore hidden>
      <h2 id="choose-model"><span id="llmd-launch-settings-heading"></span>Choose a model</h2>
      <div class="llmd-launch-field llmd-launch-checkpoint">
        <select id="llmd-launch-checkpoint" name="checkpoint" aria-labelledby="choose-model" aria-describedby="llmd-launch-checkpoint-hint">
          <optgroup label="LFM">
            <option selected>LiquidAI/LFM3-1.7B</option>
          </optgroup>
        </select>
      </div>
    </section>

    <section aria-labelledby="choose-drafter" data-launch-control data-pagefind-ignore hidden>
      <h2 id="choose-drafter">Choose a drafter <span class="llmd-launch-optional">(optional)</span></h2>
      <div class="llmd-launch-field">
        <select id="llmd-launch-drafter" name="drafter" aria-labelledby="choose-drafter" aria-describedby="llmd-drafter-hint">
          <option value="">No drafter</option>
        </select>
      </div>
      <p class="llmd-launch-error" data-link-error role="status" hidden>This link specifies a drafter or launch setting that is unavailable. Check your platform, model, and drafter selections.</p>
    </section>

    <section aria-labelledby="loading-methods" data-launch-control data-pagefind-ignore hidden>
      <h2 id="loading-methods">Choose a weight source</h2>
      <div class="llmd-launch-field">
        <select id="llmd-launch-source" name="source" aria-describedby="llmd-launch-source-hint">
          <option value="hub">Load at launch</option>
          <option value="download">Download first</option>
          <option value="local">Already downloaded</option>
        </select>
        <span class="llmd-launch-field-hint" id="llmd-launch-source-hint" data-source-hint></span>
      </div>
      <div class="llmd-launch-field" data-local hidden>
        <label for="llmd-launch-directory">Host model directory</label>
        <textarea id="llmd-launch-directory" name="directory" rows="2" wrap="soft" spellcheck="false" autocomplete="off" aria-required="true" aria-describedby="llmd-launch-directory-hint llmd-launch-directory-error">${HOME}/models/LiquidAI/LFM3-1.7B</textarea>
        <span class="llmd-launch-field-error" id="llmd-launch-directory-error" data-field-error="directory" aria-live="polite"></span>
      </div>
      <div class="llmd-launch-field" data-local-drafter hidden>
        <label for="llmd-launch-drafter-directory">Host drafter directory</label>
        <textarea id="llmd-launch-drafter-directory" name="drafterDirectory" rows="2" wrap="soft" spellcheck="false" autocomplete="off" aria-required="true" aria-describedby="llmd-launch-directory-hint llmd-launch-drafter-directory-error"></textarea>
        <span class="llmd-launch-field-error" id="llmd-launch-drafter-directory-error" data-field-error="drafterDirectory" aria-live="polite"></span>
      </div>
      <p class="llmd-launch-hint">
        <a href="../../reference/environment-variables/#gated-model-access">Set up Hugging Face access for gated weights</a>.
        <a href="../../reference/model-and-listener-flags/#local-model-files">Required model files</a>
      </p>
    </section>

    <section aria-labelledby="download-weights-heading" data-toc-parent="loading-methods" data-download-weights data-pagefind-ignore hidden>
      <h2 id="download-weights-heading" data-toc-label="Download weights">Download weights</h2>
      <p class="llmd-launch-hint">Run these commands on the LLMD host with <a href="https://docs.astral.sh/uv/getting-started/installation/">uv</a> installed.</p>
      <div class="command-shell" hidden>
        <span class="command-language icon-code" id="download-checkpoint">Download model · Host shell</span>
        <pre><code class="sh" data-command="download" data-copy-label="Copy model download command"></code></pre>
      </div>
      <div class="command-shell" hidden>
        <span class="command-language icon-code" id="download-drafter">Download drafter · Host shell</span>
        <pre><code class="sh" data-command="drafter-download" data-copy-label="Copy drafter download command"></code></pre>
      </div>
    </section>

    <section aria-labelledby="start-the-server">
      <h2 id="start-the-server"><span id="llmd-launch-steps"></span>Start LLMD</h2>
      <div class="llmd-launch-field" data-port data-launch-control data-pagefind-ignore hidden>
        <label for="llmd-launch-port">Host port</label>
        <input id="llmd-launch-port" name="port" type="text" inputmode="numeric" value="8000" aria-required="true" aria-describedby="llmd-launch-port-error">
        <span class="llmd-launch-field-error" id="llmd-launch-port-error" data-field-error="port" aria-live="polite"></span>
      </div>
      <p class="llmd-launch-error" role="status" data-error data-pagefind-ignore hidden>Correct the settings above to generate the server command.</p>
      <div class="command-shell">
        <span class="command-language icon-code">Host shell</span>
        <pre><code class="sh" data-command="launch" data-copy-label="Copy LLMD server command">llmd --listen=127.0.0.1:8000 \
  --model=hf://LiquidAI/LFM3-1.7B</code></pre>
      </div>
      <p class="llmd-launch-hint"><a href="../../howto/deploy-llmd/">Deployment guide</a> · <a href="../../reference/model-and-listener-flags/">Model and listener flags</a></p>
    </section>

    <section aria-labelledby="check-the-loaded-model">
      <h2 id="check-the-loaded-model">List models</h2>
      <p class="llmd-launch-hint">After LLMD finishes loading, run this in a second terminal on the host.</p>
      <div class="command-shell">
        <span class="command-language icon-code">Host shell</span>
        <pre><code class="sh" data-command="models" data-copy-label="Copy model list command">curl -fsS http://127.0.0.1:8000/v1/models</code></pre>
      </div>
      <p class="llmd-launch-hint">
      The response includes the served model ID. Note that LLMD doesn't support loading models after startup time,
      so it will only list the model supplied at startup.
      </p>
      <div class="command-shell">
        <span class="command-language icon-code">Example response · JSON</span>
        <pre><code class="json" data-command="models-response" data-copy-label="Copy example model list response">{
  "object": "list",
  "data": [
    {
      "id": "LFM3-1.7B",
      "object": "model",
      "created": 1795564800,
      "owned_by": "local"
    }
  ]
}</code></pre>
      </div>
    </section>

    <section aria-labelledby="first-request">
      <h2 id="first-request">Send a request</h2>
      <div class="llmd-launch-field" data-request-type data-pagefind-ignore hidden>
        <label for="llmd-request-type">Request type</label>
        <select id="llmd-request-type" name="request">
          <option value="chat">Chat</option>
          <option value="decision">Decision</option>
        </select>
      </div>
      <div id="send-a-chat-request" data-chat-request>
        <p class="llmd-launch-hint">Read the reply in <code>choices[0].message.content</code>. <a href="../../reference/chat-completions/">Chat API</a></p>
        <div class="command-shell">
          <span class="command-language icon-code">Host shell</span>
          <pre><code class="sh" data-command="chat" data-copy-label="Copy chat request command">curl -fsS http://127.0.0.1:8000/v1/chat/completions \
  -H 'Content-Type: application/json' \
  -d '{"model":"LFM3-1.7B","messages":[{"role":"user","content":"Reply with one short greeting."}]}'</code></pre>
        </div>
      </div>
      <div id="send-a-decision-request" data-decision-request hidden>
        <p class="llmd-launch-hint">Read the selected animal in <code>answers.animal.label</code>. <a href="../ask-structured-questions/">Decision tutorial</a> · <a href="../../reference/decision/">API reference</a></p>
        <div class="command-shell">
          <span class="command-language icon-code">Host shell</span>
          <pre><code class="sh" data-command="decision" data-copy-label="Copy Decision request command">curl -sS --fail-with-body http://127.0.0.1:8000/v1/systemone \
  -H 'Content-Type: application/json' \
  -d '{
    "state": "The animal sits on the mat, purrs and chases a red laser dot.",
    "questions": {
      "animal": {"kind": "choice", "instructions": "Which animal is it?", "criteria": {"cat": null, "dog": "barks"}},
      "cute": {"kind": "noul", "instructions": "Is it cute?", "ask_if": {"animal": ["cat"]}},
      "rating": {"kind": "score", "instructions": "How playful is it?", "criteria": ["low", "medium", "high"], "depends_on": ["cute"]}
    }
  }'</code></pre>
        </div>
      </div>
      <div id="send-an-embeddings-request" data-embeddings-request hidden>
        <p class="llmd-launch-hint">Read the first vector in <code>data[0].embedding</code>. <a href="../compare-texts-with-embeddings/">Text similarity tutorial</a> · <a href="../../reference/embeddings/">API reference</a></p>
        <div class="command-shell">
          <span class="command-language icon-code">Host shell</span>
          <pre><code class="sh" data-command="embeddings" data-copy-label="Copy embeddings request command">curl -sS --fail-with-body http://127.0.0.1:8000/v1/embeddings \
  -H 'Content-Type: application/json' \
  -d '{
    "input": "The quick brown fox jumps over the lazy dog.",
    "encoding_format": "float"
  }'</code></pre>
        </div>
      </div>
    </section>
  </form>
</div>
```
