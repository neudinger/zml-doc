                .fallback = "Used when both protocol-specific variables are unset or empty. Takes precedence over ALL_PROXY.",
                .effect = "Supplies a fallback proxy for HTTP and HTTPS model downloads.",
            },
            .{
                .name = "ALL_PROXY",
                .fallback = "Used when the protocol-specific variables and all_proxy are unset or empty.",
                .effect = "Supplies a fallback proxy for HTTP and HTTPS model downloads.",
            },
        ] },
