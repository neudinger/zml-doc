---
.title = "Write your first ZML model",
.description = "Define a tagged linear layer, compile it for CPU, and read its output back on the host.",
.date = .date("2026-11-16T00:00:00"),
.layout = "content.shtml",
.custom = .{ .doc_section = "Developer Guide" },
---
Use the checkout and Bazel version from the [ZML quickstart]($link.page('zml/user-guide/quickstart')).

# [Inside main.zig]($heading.id('compile-and-call-the-layer'))

```=html
<fieldset class="command-tabs model-walkthrough" id="describe-the-computation" data-toc-parent="compile-and-call-the-layer">
  <legend>Model stage</legend>
  <div class="model-stage">
    <label id="stage-describe" class="command-tab" data-toc-label="Describe"><input type="radio" name="model-stage" aria-controls="describe-code" checked><span>Describe</span></label>
    <div class="model-stage-panel" id="describe-code">
      <pre><code class="zig">return self.weight.dot(input, .feature).add(self.bias);</code></pre>
      <p>Each weight row has three features. <code>dot</code> sums their products with the input along <code>.feature</code>. Adding one bias per row gives two output scores.</p>
    </div>
  </div>
  <div class="model-stage">
    <label id="stage-compile" class="command-tab" data-toc-label="Compile"><input type="radio" name="model-stage" aria-controls="compile-code"><span>Compile</span></label>
    <div class="model-stage-panel" id="compile-code">
      <pre><code class="zig">var executable = try platform.compile(allocator, io, layer, .forward, .{input}, .{});</code></pre>
      <p>ZML traces <code>forward</code> with the shapes and types of the symbolic tensors. It produces an executable for the selected platform.</p>
    </div>
  </div>
  <div class="model-stage">
    <label id="stage-bind" class="command-tab" data-toc-label="Bind"><input type="radio" name="model-stage" aria-controls="bind-code"><span>Bind</span></label>
    <div class="model-stage-panel" id="bind-code">
      <pre><code class="zig">args.set(.{ layer_buffers, input_buffer });</code></pre>
      <p><code>Buffer.fromSlice</code> copies the weights, biases and input from host memory into device buffers. <code>args.set</code> binds those buffers to the executable. The caller owns them.</p>
    </div>
  </div>
  <div class="model-stage">
    <label id="stage-call" class="command-tab" data-toc-label="Call"><input type="radio" name="model-stage" aria-controls="call-code"><span>Call</span></label>
    <div class="model-stage-panel" id="call-code">
      <pre><code class="zig">executable.call(io, args, &amp;results, .{ .wait = true });</code></pre>
      <p>Wait for execution to finish, retrieve the output buffer with <code>results.get</code>, then copy its two scores back to the host with <code>getValue</code>.</p>
    </div>
  </div>
</fieldset>
```

# [Run the complete example]($heading.id('run-the-model'))

Create `examples/first_model/` in your ZML checkout. Save both files there.

```=html
<div data-toc-parent="run-the-model">
<details class="model-source" id="main-zig" data-toc-label="main.zig">
  <summary>main.zig</summary>
  <pre><code class="zig" data-copy-label="Copy main.zig">const std = @import("std");
const zml = @import("zml/user-guide");

const Linear = struct {
    weight: zml.Tensor,
    bias: zml.Tensor,

    pub fn forward(self: Linear, input: zml.Tensor) zml.Tensor {
        return self.weight.dot(input, .feature).add(self.bias);
    }
};

pub fn main(init: std.process.Init) !void {
    const allocator = init.gpa;
    const io = init.io;
    const platform: *zml.Platform = try .auto(allocator, io, .{});
    defer platform.deinit(allocator, io);

    const layer: Linear = .{
        .weight = zml.Tensor.init(.{ 2, 3 }, .f32).withTags(.{ .output, .feature }),
        .bias = zml.Tensor.init(.{2}, .f32).withTags(.{.output}),
    };
    const input = zml.Tensor.init(.{3}, .f32).withTags(.{.feature});
    var executable = try platform.compile(allocator, io, layer, .forward, .{input}, .{});
    defer executable.deinit();

    const weights = [2][3]f32{ .{ 1, 2, 3 }, .{ 4, 5, 6 } };
    const biases = [2]f32{ 1, -1 };
    const features = [3]f32{ 1, 2, 1 };
    const weight_values = zml.Slice.init(layer.weight.shape(), std.mem.asBytes(&amp;weights));
    const bias_values = zml.Slice.init(layer.bias.shape(), std.mem.asBytes(&amp;biases));
    const input_values = zml.Slice.init(input.shape(), std.mem.asBytes(&amp;features));

    var weight_buffer = try zml.Buffer.fromSlice(io, platform, weight_values);
    defer weight_buffer.deinit();
    var bias_buffer = try zml.Buffer.fromSlice(io, platform, bias_values);
    defer bias_buffer.deinit();
    var input_buffer = try zml.Buffer.fromSlice(io, platform, input_values);
    defer input_buffer.deinit();
    const layer_buffers: zml.Bufferized(Linear) = .{
        .weight = weight_buffer,
        .bias = bias_buffer,
    };

    var args = try executable.args(allocator);
    defer args.deinit(allocator);
    args.set(.{ layer_buffers, input_buffer });

    var results = try executable.results(allocator);
    defer results.deinit(allocator);
    executable.call(io, args, &amp;results, .{ .wait = true });

    var output_buffer = results.get(zml.Buffer);
    defer output_buffer.deinit();
    const scores = try output_buffer.getValue([2]f32, io);
    std.debug.print("Scores: {d:.1}, {d:.1}\n", .{ scores[0], scores[1] });
}
</code></pre>
</details>
<details class="model-source" id="build-bazel" data-toc-label="BUILD.bazel">
  <summary>BUILD.bazel</summary>
  <pre><code class="starlark" data-copy-label="Copy BUILD.bazel">load("@rules_zig//zig:defs.bzl", "zig_binary")

zig_binary(
    name = "first_model",
    main = "main.zig",
    deps = ["//zml"],
)
</code></pre>
</details>
<p id="bazel-command" data-toc-label="Bazel command">Run from the checkout root. CPU is enabled by default.</p>
<pre><code class="sh">bazel run //examples/first_model
</code></pre>
<p class="model-expected-output" id="expected-output" data-toc-label="Expected output"><strong>Expected output</strong><br><code>Scores: 9.0, 19.0</code></p>
</div>
```

# [Load pretrained model weights]($heading.id('load-weights-from-a-checkpoint'))

The [MNIST example](https://github.com/zml/zml/blob/8fcff8c462070d06056f8a85ba0c8a81f0f3a636/examples/mnist/mnist.zig)
uses the same steps with pretrained weights. See how to
[load model weights into device buffers]($link.page('zml/developer-guide/load-and-inspect-model-weights').ref('load-weights-for-execution')).

The example above follows the pinned ZML source APIs. Execution of the new
target remains pending.
